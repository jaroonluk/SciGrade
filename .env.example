APP_NAME="ระบบรายงานผลการสอบ SciGrade"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SCIGRAD_DB_HOST=127.0.0.1
SCIGRAD_DB_PORT=3306
SCIGRAD_DB_DATABASE=eoffice
SCIGRAD_DB_USERNAME=root
SCIGRAD_DB_PASSWORD=

REG_DB_HOST=127.0.0.1
REG_DB_PORT=3306
REG_DB_DATABASE=reg
REG_DB_USERNAME=root
REG_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on HTTPS production (e.g. https://gms.sc.kku.ac.th)
SESSION_SECURE_COOKIE=true

# Production OAuth (example):
# APP_ENV=production
# APP_URL=https://gms.sc.kku.ac.th
# SESSION_SECURE_COOKIE=true
# Google Cloud Console must include BOTH authorized redirect URIs:
#   https://gms.sc.kku.ac.th/auth/google/callback
#   http://127.0.0.1:8000/auth/google/callback
# Callback URL is chosen from the host the user opened (local vs server).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=minio
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO / S3-compatible storage for uploads (grade reports, dept submissions)
MINIO_ENDPOINT=s3.sc.kku.ac.th
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_INSECURE_SKIP_VERIFY=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gms
MINIO_REGION=us-east-1
MINIO_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. When empty or ignored, callback follows the host used to log in.
GOOGLE_REDIRECT_URI=

# Comma-separated usernames (tbluser.username) that always have Super Admin
SCIGRADE_SUPER_ADMIN_USERNAMES=

# Optional override for the thesis grade homepage button (leave empty to use /thesis-grades)
THESIS_GRADE_URL=
SCIGRADE_REG_URL=https://reg.kku.ac.th
SCIGRADE_S0_LETTER_FORM_URL=https://kku.world/cq7gj
